<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- The agent identity and its read-only grants live in
             mrp_mcp_tools, because the tools are what it runs. This
             module adds only the people who review what it proposes. -->

        <record id="group_mcp_reviewer" model="res.groups">
            <field name="name">Proposal Reviewer</field>
            <field name="privilege_id" ref="mrp_mcp_tools.res_groups_privilege_mcp"/>
            <field name="comment">May approve, reject and apply agent proposals. Applying still requires the ordinary rights of the target document.</field>
        </record>

        <record id="group_mcp_manager" model="res.groups">
            <field name="name">MCP Manager</field>
            <field name="privilege_id" ref="mrp_mcp_tools.res_groups_privilege_mcp"/>
            <field name="implied_ids" eval="[(4, ref('group_mcp_reviewer'))]"/>
        </record>

        <!-- An agent may read back only what it produced itself. Without this
             rule one compromised session could read every other session's
             proposals. -->
        <!-- Scoped by create_uid, not requested_uid: the agent identity is
             what creates the record, while requested_uid names the person it
             acted for. Filtering on requested_uid would leave the agent unable
             to read back anything it had just written. Give each deployment
             its own agent user and this isolates them from one another. -->
        <record id="rule_proposal_agent_own_session" model="ir.rule">
            <field name="name">Agent sees only proposals it created</field>
            <field name="model_id" ref="model_mcp_proposal"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('mrp_mcp_tools.group_mcp_agent'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_proposal_company" model="ir.rule">
            <field name="name">Proposals are company bound</field>
            <field name="model_id" ref="model_mcp_proposal"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_tool_call_company" model="ir.rule">
            <field name="name">Tool calls are company bound</field>
            <field name="model_id" ref="model_mcp_tool_call"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

    </data>
</odoo>
